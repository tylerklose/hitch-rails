source "https://rubygems.org"

gemspec path: ".."

# Rails main is 8.2.0.alpha — the version production dogfoods. No 8.2
# prerelease gem is published, so tracking the branch is the only way to
# test it. No lockfile is committed on purpose: a pinned SHA would stop
# reflecting what main is today.
gem "rails", github: "rails/rails", branch: "main"
gem "sqlite3", ">= 2.1", "< 3"
gem "puma"
gem "rubocop-rails-omakase", require: false
gem "redis", ">= 5", "< 7"
