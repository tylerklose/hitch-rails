#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require "pathname"
require "yaml"

REQUIRED_ADRS = %w[
  docs/adr/0001-mcp-sdk-boundary.md
  docs/adr/0002-registry-and-reload.md
  docs/adr/0003-tool-policy-and-errors.md
  docs/adr/0004-rate-limit-and-observation.md
].freeze
REQUIRED_DOCUMENTS = %w[
  CONTRIBUTING.md
  docs/architecture/mcp-data-flow.md
  docs/releasing.md
  docs/security/mcp-threat-model.md
].freeze
REQUIRED_API_FIELDS = %w[name kind visibility introduced inputs outputs errors reload_behavior].freeze
EXPECTED_API_ERRATA = [
  {
    "id" => "endpoint_registry_prepare_cycle",
    "checkpoint" => "0.2.0.pre.4",
    "classification" => "documentation_correction",
    "incorrect" => "Resolves configured registry class by name on each request.",
    "corrected" => "Each request reads the current immutable snapshot; the configured registry is constantized and validated on every Rails prepare cycle.",
    "runtime_evidence" => %w[
      lib/hitch/engine.rb
      lib/hitch/mcp/configuration.rb
      app/controllers/concerns/hitch/mcp/endpoint.rb
      test/hitch/mcp/registry_reload_test.rb
    ]
  }
].freeze
REQUIRED_INVARIANT_FIELDS = %w[id statement owner_issue source_targets mutation killing_tests].freeze
REQUIRED_PROBE_IDS = %w[
  structural_symbol_keys
  selective_argument_symbolization
  final_request_meta_shape
  capability_handler_leak
  final_discover_fields
  unsafe_error_detail
  output_validation_default
  callback_configuration_merge
  instrumentation_contains_arguments
  streamable_http_raw_body_callback
  reserved_server_context_collision
  hitch_context_wrapper
  tool_name_validation_divergence
  mutable_server_request_state
  separately_named_sdk_lanes
].freeze
REQUEST_EVENT_KEYS = %w[
  schema_version request_id method tool_name principal_type principal_key client_key
  http_status protocol_code outcome request_bytes response_bytes duration_ms
].freeze
INVOCATION_EVENT_KEYS = %w[
  schema_version request_id tool_name availability argument_policy executed
  result_category duration_ms
].freeze
SENSITIVE_EVENT_KEYS = %w[
  authorization access_token bearer secret request_body body arguments result
  exception exception_message backtrace client_info meta _meta
].freeze
REQUIRED_ISSUE_LINKS = %w[
  https://github.com/modelcontextprotocol/ruby-sdk/issues/389
  https://github.com/modelcontextprotocol/ruby-sdk/issues/351
  https://github.com/modelcontextprotocol/modelcontextprotocol/issues/986
].freeze

root = File.expand_path("..", __dir__)
OptionParser.new { |options| options.on("--root PATH") { |path| root = File.expand_path(path) } }.parse!(ARGV)
errors = []

def load_yaml(root, relative_path, errors)
  path = File.join(root, relative_path)
  document = YAML.safe_load_file(path, permitted_classes: [], aliases: false)
  errors << "#{relative_path}: schema_version must be 1" unless document.is_a?(Hash) && document["schema_version"] == 1
  document
rescue Errno::ENOENT, Psych::Exception => error
  errors << "#{relative_path}: #{error.message}"
  {}
end

api = load_yaml(root, "docs/contracts/mcp_public_api.yml", errors)
invariants = load_yaml(root, "docs/contracts/mcp_invariants.yml", errors)
probes = load_yaml(root, "docs/contracts/sdk_probes.yml", errors)

entries = api["entries"]
errors << "mcp_public_api.yml: exact documentation erratum differs" unless api["errata"] == EXPECTED_API_ERRATA
errors << "mcp_public_api.yml: entries must be a nonempty array" unless entries.is_a?(Array) && entries.any?
entries ||= []
names = []
entries.each_with_index do |entry, index|
  unless entry.is_a?(Hash)
    errors << "API entry #{index}: must be a mapping"
    next
  end

  REQUIRED_API_FIELDS.each do |field|
    errors << "API entry #{index}: #{field} is missing" if entry[field].nil? || entry[field].to_s.strip.empty?
  end
  name = entry["name"].to_s
  errors << "duplicate API entry #{name}" if names.include?(name)
  names << name
  errors << "#{name}: visibility must be public or private" unless %w[public private].include?(entry["visibility"])

  next unless entry["kind"] == "event"

  payload_keys = entry["payload_keys"]
  errors << "#{name}: payload_keys must be a nonempty array" unless payload_keys.is_a?(Array) && payload_keys.any?
  sensitive = Array(payload_keys).map(&:to_s) & SENSITIVE_EVENT_KEYS
  errors << "#{name}: sensitive event keys #{sensitive.join(', ')}" if sensitive.any?
end

request_event = entries.find { |entry| entry.is_a?(Hash) && entry["name"] == "request.hitch_mcp" }
invocation_event = entries.find { |entry| entry.is_a?(Hash) && entry["name"] == "invocation.hitch_mcp" }
errors << "request.hitch_mcp: exact payload key set differs" unless request_event&.fetch("payload_keys", [])&.map(&:to_s) == REQUEST_EVENT_KEYS
errors << "invocation.hitch_mcp: exact payload key set differs" unless invocation_event&.fetch("payload_keys", [])&.map(&:to_s) == INVOCATION_EVENT_KEYS
adapter = entries.find { |entry| entry.is_a?(Hash) && entry["name"] == "Hitch::MCP::SDKAdapter" }
errors << "SDKAdapter must be explicitly private" unless adapter && adapter["visibility"] == "private"

invariant_rows = invariants["invariants"]
errors << "mcp_invariants.yml: invariants must be a nonempty array" unless invariant_rows.is_a?(Array) && invariant_rows.any?
invariant_rows ||= []
invariant_ids = []
invariant_rows.each_with_index do |invariant, index|
  unless invariant.is_a?(Hash)
    errors << "Invariant #{index}: must be a mapping"
    next
  end
  REQUIRED_INVARIANT_FIELDS.each do |field|
    value = invariant[field]
    errors << "Invariant #{index}: #{field} is missing" if value.nil? || (value.respond_to?(:empty?) && value.empty?)
  end
  id = invariant["id"].to_s
  errors << "#{id}: invalid invariant id" unless id.match?(/\AINV-MCP-\d{3}\z/)
  errors << "duplicate invariant #{id}" if invariant_ids.include?(id)
  invariant_ids << id
  Array(invariant["source_targets"]).each do |target|
    path = Pathname.new(target.to_s)
    errors << "#{id}: source target must be relative: #{target}" if path.absolute? || target.to_s.include?("..")
  end
  errors << "#{id}: mutation vector is missing" if invariant["mutation"].to_s.strip.empty?
  errors << "#{id}: killing tests are missing" if !invariant["killing_tests"].is_a?(Array) || invariant["killing_tests"].empty?
end

probe_rows = probes["probes"]
errors << "sdk_probes.yml: probes must be a nonempty array" unless probe_rows.is_a?(Array) && probe_rows.any?
probe_rows ||= []
probe_ids = probe_rows.filter_map { |probe| probe["id"] if probe.is_a?(Hash) }
errors << "sdk_probes.yml: required probe set differs" unless probe_ids.sort == REQUIRED_PROBE_IDS.sort
probe_rows.each_with_index do |probe, index|
  unless probe.is_a?(Hash)
    errors << "Probe #{index}: must be a mapping"
    next
  end
  %w[id observation decision runtime_test].each do |field|
    errors << "#{probe['id'] || index}: #{field} is missing" if probe[field].to_s.strip.empty?
  end
  errors << "#{probe['id']}: status must be reproduced" unless probe["status"] == "reproduced"
  references = probe["references"]
  unless references.is_a?(Array) && references.any? && references.all? { |url| url.to_s.start_with?("https://github.com/modelcontextprotocol/") }
    errors << "#{probe['id']}: references must contain exact modelcontextprotocol GitHub URLs"
  end
end

probe_text = File.file?(File.join(root, "docs/contracts/sdk_probes.yml")) ? File.read(File.join(root, "docs/contracts/sdk_probes.yml")) : ""
REQUIRED_ISSUE_LINKS.each do |link|
  errors << "sdk_probes.yml: missing upstream issue link #{link}" unless probe_text.include?(link)
end

REQUIRED_ADRS.each do |relative_path|
  path = File.join(root, relative_path)
  unless File.file?(path)
    errors << "missing ADR #{relative_path}"
    next
  end
  content = File.read(path)
  %w[Status Context Decision Consequences].each do |heading|
    errors << "#{relative_path}: missing ## #{heading}" unless content.match?(/^## #{heading}\s*$/)
  end
  errors << "#{relative_path}: status is not accepted" unless content.match?(/^Accepted\b/m)
end

REQUIRED_DOCUMENTS.each do |relative_path|
  path = File.join(root, relative_path)
  errors << "missing contract document #{relative_path}" unless File.file?(path) && !File.read(path).strip.empty?
end

data_flow_path = File.join(root, "docs/architecture/mcp-data-flow.md")
if File.file?(data_flow_path)
  data_flow = File.read(data_flow_path)
  %w[Host authentication admission verified-request registry SDKAdapter authorize Result].each do |term|
    errors << "mcp-data-flow.md: missing stage #{term}" unless data_flow.include?(term)
  end
end

if errors.any?
  warn errors.join("\n")
  exit 1
end

puts "Verified #{entries.length} API entries, #{invariant_rows.length} invariants, #{probe_rows.length} SDK probes, and #{REQUIRED_ADRS.length} ADRs"
