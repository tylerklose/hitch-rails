      "then_not": { "parameter": "public_outcome", "value": "generic_error" }
    },
    {
      "type": "invalid_pair",
      "if": { "parameter": "wire_size", "value": "exact" },
      "then_not": { "parameter": "public_outcome", "value": "generic_error" }
    },
    {
      "type": "forced",
      "assignments": [
        { "parameter": "result_path", "value": "text" },
