#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "fileutils"
require "open3"
require "rbconfig"
require "tmpdir"
require_relative "../tooling/checkpoint_release"
require_relative "../tooling/final_release"

ROOT = File.expand_path("..", __dir__)

def usage!(message = nil)
  warn message if message
  warn "Usage: bin/prepare-release-artifact [--candidate | --ready-for-authority | --checkpoint] VERSION DESTINATION"
  warn "--checkpoint stages an accepted internal 0.2.0.pre.4, 0.2.0.rc1, or 0.2.0.rc2 artifact."
  exit 64
end

def git_status!
  output, status = Open3.capture2e(
    "git", "status", "--porcelain=v1", "-z", "--untracked-files=all",
    chdir: ROOT
  )
  raise "could not inspect repository status" unless status.success?

  output
end

def git_value!(*arguments)
  output, status = Open3.capture2e("git", *arguments, chdir: ROOT)
  raise "could not resolve git #{arguments.join(' ')}" unless status.success?

  output.strip
end

def verify_source_unchanged!(before_status:, before_commit:, before_tree:)
  raise "preparing the release artifact changed the repository" unless git_status! == before_status
  raise "preparing the release artifact changed HEAD" unless git_value!("rev-parse", "HEAD") == before_commit
  raise "preparing the release artifact changed the source tree" unless
    git_value!("rev-parse", "HEAD^{tree}") == before_tree
end

ready_for_authority = ARGV.delete("--ready-for-authority")
candidate_mode = ARGV.delete("--candidate")
checkpoint_mode = ARGV.delete("--checkpoint")
if [ ready_for_authority, candidate_mode, checkpoint_mode ].compact.length > 1
  usage!("Choose only one artifact preparation mode")
end
version = ARGV.shift
destination = ARGV.shift
usage! unless version && destination
usage!("Unexpected arguments: #{ARGV.join(' ')}") unless ARGV.empty?
if checkpoint_mode
  usage!("--checkpoint supports only #{HitchCheckpointRelease::CHECKPOINTS.keys.join(', ')}") unless
    HitchCheckpointRelease::CHECKPOINTS.key?(version)
else
  usage!("Only 0.2.0 is supported outside --checkpoint mode") unless version == HitchFinalRelease::RELEASE
end

before_status = git_status!
raise "preparing a release artifact requires a clean worktree" unless before_status.empty?
before_commit = git_value!("rev-parse", "HEAD")
before_tree = git_value!("rev-parse", "HEAD^{tree}")

gate_arguments = if checkpoint_mode
  case version
  when "0.2.0.pre.4" then []
  when "0.2.0.rc1" then [ "--through", "M6" ]
  when "0.2.0.rc2" then [ "--through", "M7" ]
  end
elsif candidate_mode
  [ "--through", "M7" ]
elsif ready_for_authority
  [ "--ready-for-authority", version ]
else
  [ "--preflight", version ]
end
output, status = Open3.capture2e(
  RbConfig.ruby,
  File.join(ROOT, "bin/verify-release-evidence"),
  *gate_arguments,
  chdir: ROOT
)
unless status.success?
  warn output
  exit status.exitstatus
end

authority = !ready_for_authority && !candidate_mode && !checkpoint_mode
record = if checkpoint_mode
  HitchCheckpointRelease.candidate!(root: ROOT, version:)
elsif candidate_mode
  commit = before_commit
  tree = before_tree
  candidate = Dir.mktmpdir("hitch-final-candidate-") do |directory|
    built = HitchReleaseArtifact.rebuild!(
      root: ROOT,
      commit:,
      version:,
      destination: directory,
      expected_tree: tree
    )
    HitchFinalRelease.validate_package!(artifact: built.fetch("artifact_path"), version:)
    {
      "version" => version,
      "artifact" => built.fetch("artifact"),
      "sha256" => built.fetch("sha256"),
      "source_commit" => commit,
      "source_tree" => tree
    }
  end
  { "candidate" => candidate, "evidence_path" => nil, "evidence_sha256" => nil }
else
  HitchFinalRelease.candidate!(root: ROOT, authority:)
end
source_postcondition = lambda do
  verify_source_unchanged!(before_status:, before_commit:, before_tree:)
end
stager = checkpoint_mode ? HitchCheckpointRelease : HitchFinalRelease
result = stager.stage!(
  root: ROOT,
  candidate: record.fetch("candidate"),
  destination:,
  before_publish: source_postcondition
)
begin
  source_postcondition.call
rescue StandardError
  FileUtils.rm_f(result.fetch("artifact_path"))
  raise
end

puts JSON.pretty_generate(
  "mode" => if checkpoint_mode
              "internal_checkpoint"
            elsif candidate_mode
              "candidate"
            elsif authority
              "authorized"
            else
              "ready_for_authority"
            end,
  "evidence" => if checkpoint_mode
                  record.slice("evidence_path", "evidence_sha256").merge(
                    "gate" => ([ "bin/verify-release-evidence" ] + gate_arguments).join(" ")
                  )
                elsif candidate_mode
                  { "gate" => "bin/verify-release-evidence --through M7" }
                else
                  record.slice("evidence_path", "evidence_sha256")
                end,
  "artifact" => result.slice("artifact", "artifact_path", "sha256", "commit", "tree", "version"),
  "validation" => result.fetch("validation")
)
