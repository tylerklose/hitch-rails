{
  "model_name": "hitch_tool_generator",
  "_intent_notes": [
    "Pairwise name, namespace, registry-state, and collision model for M5.2.",
    "Every row runs the real Rails generator against a temporary host tree.",
    "Only a valid normalized name and namespace with no owned collision may write files.",
    "The host registry is never created, edited, or deleted by hitch:tool."
  ],
  "parameters": [
    {
      "name": "name",
      "values": [
        "simple_snake",
        "nested_slash",
        "nested_constant",
        "hyphenated",
        "invalid"
      ]
    },
    {
      "name": "namespace",
      "values": ["default", "custom_valid", "invalid"]
    },
    {
      "name": "registry",
      "values": ["absent", "present"]
    },
    {
      "name": "collision",
      "values": [
        "none",
        "tool_file",
        "test_file",
        "tool_constant",
        "test_constant",
        "manifest"
      ]
    }
  ],
  "constraints": [
    {
      "type": "forced",
      "_why": "Default simple-name golden path with an installed registry.",
      "assignments": [
        {"parameter": "name", "value": "simple_snake"},
        {"parameter": "namespace", "value": "default"},
        {"parameter": "registry", "value": "present"},
        {"parameter": "collision", "value": "none"}
      ]
    },
    {
      "type": "forced",
      "_why": "Slash-nested normalization without a registry still generates but does not create one.",
      "assignments": [
        {"parameter": "name", "value": "nested_slash"},
        {"parameter": "namespace", "value": "default"},
        {"parameter": "registry", "value": "absent"},
        {"parameter": "collision", "value": "none"}
      ]
    },
    {
      "type": "forced",
      "_why": "Constant-nested input plus a custom root namespace remains deterministic.",
      "assignments": [
        {"parameter": "name", "value": "nested_constant"},
        {"parameter": "namespace", "value": "custom_valid"},
        {"parameter": "registry", "value": "present"},
        {"parameter": "collision", "value": "none"}
      ]
    },
    {
      "type": "forced",
      "_why": "Hyphenated input has one explicit normalization golden path.",
      "assignments": [
        {"parameter": "name", "value": "hyphenated"},
        {"parameter": "namespace", "value": "default"},
        {"parameter": "registry", "value": "present"},
        {"parameter": "collision", "value": "none"}
      ]
    }
  ]
}
