+/**
+ * Optional harness-only authentication for protected server fixtures.
+ *
+ * The bearer value is read from a private file instead of argv or an
+ * environment value so process listings and captured commands never contain
+ * credentials. Production clients must provide authentication through their
+ * own transport; this is only an input bridge for the conformance runner.
+ */
+export function conformanceAuthorizationHeaders(): Record<string, string> {
+  const path = process.env.MCP_CONFORMANCE_AUTHORIZATION_FILE;
+  if (!path) return {};
+
+  const stat = statSync(path);
+  if ((stat.mode & 0o077) !== 0) {
+    throw new Error(
+      'MCP_CONFORMANCE_AUTHORIZATION_FILE must not be accessible by group or others'
+    );
+  }
+
+  const value = readFileSync(path, 'utf8');
+  if (!/^Bearer [A-Za-z0-9_-]{1,512}$/.test(value)) {
+    throw new Error(
+      'MCP_CONFORMANCE_AUTHORIZATION_FILE must contain one bounded Bearer credential'
+    );
+  }
+
+  return { Authorization: value };
+}
