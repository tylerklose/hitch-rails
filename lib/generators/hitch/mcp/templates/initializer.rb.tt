# frozen_string_literal: true

# Generated by hitch:mcp:install. Host policy stays explicit and deny-default.
Hitch.configure do |config|
  config.mcp.registry = "McpToolRegistry"
  config.mcp.server_info = lambda do |_context|
    {
      name: Rails.application.class.module_parent_name.underscore.dasherize,
      version: "1.0.0"
    }
  end

  # Replace this with one request-local host scope object when tools need it.
  config.mcp.scope_resolver = ->(principal:, access_token:, request:) { nil }

  config.mcp.request_limit = { to: 120, within: 1.minute }
  # Admission counts through config.cache_store by default. Set this only to
  # keep MCP admission out of the application's general cache. Production
  # refuses a store that cannot count across processes; see
  # docs/operator/rate_limiting.md.
  # config.mcp.rate_limit_store = ActiveSupport::Cache::RedisCacheStore.new(url: ENV["HITCH_MCP_REDIS_URL"])
  config.mcp.max_request_bytes = 1.megabyte
  config.mcp.max_result_bytes = 1.megabyte
end
