#!/usr/bin/env ruby
# frozen_string_literal: true

require "find"
require "optparse"
require "pathname"
require "set"

root = File.expand_path("..", __dir__)
OptionParser.new { |options| options.on("--root PATH") { |path| root = File.expand_path(path) } }.parse!(ARGV)

patterns = {
  "removed principal model option" => /\bprincipal_(?:model|class)\b/,
  "removed post-login redirect option" => /\bpost_login_redirect\b/,
  "wrong consent override path" => %r{app/views/hitch/oauth/authorizations},
  "obsolete RFC 9207 gap" => /does not yet send the RFC 9207/i,
  "PostgreSQL-only support claim" => /Postgres(?:QL)? (?:only|required)|PostgreSQL \(the clients table uses an array column\)/i,
  "obsolete SDK version claim" => /\b0\.24\.0\b/,
  "obsolete MCP revision" => /2025-11-25/,
  "preflight routed through token exchange" => /tokens#preflight/,
  "missing host MCP preflight action" => /mcp_server#preflight/,
  "hard-coded origin constant" => /\bALLOWED_ORIGINS\b/,
  "unconditional DCR alongside CIMD" => /DCR (?:keeps working|continues to work unchanged)/i,
  "PostgreSQL-only code consumption" => /FOR UPDATE SKIP LOCKED/,
  "blanket installation conformance claim" => /(?:new installations?|fresh install) (?:become|is|are) (?:spec-)?conformant/i,
  "obsolete unimplemented MCP endpoint claim" => /authenticated endpoint (?:and registry )?remain(?:s)? (?:under construction|a later milestone)|while the 0\.2 endpoint is built|forthcoming authenticated MCP endpoint/i,
  "tool generator auto-registration" => /\btool generator (?:automatically |now )?registers? (?:a |the )?tool/i,
  "tool generator registry mutation" => /\btool generator (?:creates|edits|updates|appends to) (?:the )?(?:MCP )?Registry/i,
  "generated tool allow-default" => /generated tools? (?:are|start) (?:available|enabled|registered) by default/i,
  "automatic tool discovery" => /Hitch (?:automatically )?discovers? (?:all )?tool classes/i,
  "production memory rate store" => /production (?:may|can|does|should|uses|supports).{0,60}memory (?:rate )?store|memory (?:rate )?store.{0,60}(?:valid|supported|recommended) (?:in|for) production/i,
  "optional production Redis" => /Redis (?:is )?optional (?:in|for) production|production.{0,60}Redis.{0,20}optional/i,
  "doctor repair mode" => /hitch:doctor (?:automatically )?(?:fixes|repairs|rewrites|migrates|updates) /i,
  "obsolete doctor format variable" => /(?<!HITCH_DOCTOR_)FORMAT=json bin\/rails hitch:doctor/,
  "MCP route after engine mount" => /MCP route (?:may|can|should|must) (?:follow|come after) (?:the )?(?:Hitch )?engine mount/i,
  "doctor application quota mutation" => /doctor (?:uses|increments|tests|writes) (?:the )?(?:application|production) (?:quota|rate-limit) keys/i,
  "doctor external discovery request" => /doctor (?:fetches|requests) discovery over (?:the )?(?:network|internet)/i
}.freeze

release_patterns = {
  "obsolete public 0.1 install" => /gem "hitch-rails", "~> 0\.1\.0"/,
  "obsolete M0 publication gate" => /M0 tags and publishes auth-only|published auth-only gem/i,
  "obsolete pre-M5 publication" => /Publish `0\.2\.0\.pre\.[123]`/,
  "obsolete M0 downloaded-gem gate" => /bin\/release-check 0\.1\.0/,
  "obsolete published M0 predecessor" => /M0\.5 and published `0\.1\.0`/i,
  "premature pre4 publication" => /0\.2\.0\.pre\.4 (?:is|was|has been) (?:publicly )?(?:published|released)|gem ["']hitch-rails["'], ["']~> 0\.2\.0\.pre\.4/i
}.freeze

historical_allowlist = {
  "PostgreSQL-only support claim" => [
    %r{\Adocs/work_packets/M0\.5\.md:\d+: .*SQLite and PostgreSQL only}
  ],
  "PostgreSQL-only code consumption" => [
    %r{\AROADMAP\.md:\d+: .*FOR UPDATE SKIP LOCKED},
    %r{\Adocs/work_packets/M0\.3b\.md:\d+: .*FOR UPDATE SKIP LOCKED}
  ]
}.freeze
used_allowlist = Set.new

included_extensions = %w[.erb .json .md .rake .rb .tt .yaml .yml].freeze
ignored_prefixes = %w[
  .git/
  .bundle/
  .ruby-lsp/
  coverage/
  docs/evidence/
  log/
  node_modules/
  pkg/
  test/dummy/log/
  tmp/
  vendor/
].freeze
ignored_files = %w[
  bin/prose-audit
].freeze

files = []
Find.find(root) do |path|
  relative = Pathname.new(path).relative_path_from(Pathname.new(root)).to_s
  if File.directory?(path)
    if relative != "." && ignored_prefixes.any? { |prefix| "#{relative}/".start_with?(prefix) }
      Find.prune
    else
      next
    end
  end
  next unless File.file?(path)
  next if ignored_files.include?(relative)
  next if relative.end_with?("_scenarios.json")

  extension = File.extname(path)
  executable_without_extension = relative.start_with?("bin/") && extension.empty?
  files << path if included_extensions.include?(extension) || executable_without_extension ||
    %w[CHANGELOG.md README.md SECURITY.md hitch-rails.gemspec].include?(relative)
end
files.uniq!
files.sort!

matches = patterns.flat_map do |label, pattern|
  found = files.flat_map do |path|
    File.readlines(path, chomp: true).filter_map.with_index(1) do |line, line_number|
      next unless line.match?(pattern)

      "#{path.delete_prefix("#{root}/")}:#{line_number}: #{line.strip}"
    end
  end

  puts %(pattern=#{label.inspect} regex=#{pattern.inspect} matches=#{found.length})
  found.filter_map do |match|
    allowlist_index = historical_allowlist.fetch(label, []).index { |allowed| allowed.match?(match) }
    if allowlist_index
      used_allowlist << [ label, allowlist_index ]
      next
    end

    [ label, match ]
  end
end

release_files = files
release_matches = release_patterns.flat_map do |label, pattern|
  found = release_files.flat_map do |path|
    File.readlines(path, chomp: true).filter_map.with_index(1) do |line, line_number|
      next unless line.match?(pattern)

      "#{path.delete_prefix("#{root}/")}:#{line_number}: #{line.strip}"
    end
  end

  puts %(pattern=#{label.inspect} regex=#{pattern.inspect} matches=#{found.length})
  found.map { |match| [ label, match ] }
end
matches.concat(release_matches)

expected_allowlist = historical_allowlist.flat_map do |label, entries|
  entries.each_index.map { |index| [ label, index ] }
end.to_set
enforce_allowlist = File.file?(File.join(root, "ROADMAP.md")) &&
  File.directory?(File.join(root, "docs/work_packets"))
unused_allowlist = enforce_allowlist ? expected_allowlist - used_allowlist : Set.new
unused_allowlist.each do |label, index|
  matches << [ "unused historical allowlist", "#{label}[#{index}]" ]
end

puts "allowlisted_historical_fixtures=#{used_allowlist.length}"
puts "patterns=#{patterns.length + release_patterns.length}"
puts "searched_files=#{files.length}"
puts "release_policy_searched_files=#{release_files.length}"

if matches.any?
  matches.each { |label, match| warn "#{label}: #{match}" }
  exit 1
end

puts "stale_matches=0"
