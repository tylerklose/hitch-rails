{
  "model_name": "hitch_dynamic_registration_metadata",
  "_intent_notes": [
    "RFC 7591 registration accepts one bounded JSON object and rejects lossy coercion.",
    "Each metadata field is validated before any Hitch::Client persistence call.",
    "Unknown string application_type values remain a compatibility omission; wrong JSON types reject."
  ],
  "parameters": [
    {
      "name": "redirect_uris",
      "values": ["valid", "empty", "too_many", "nonstring_member", "duplicate", "uri_too_long"]
    },
    {
      "name": "client_name",
      "values": ["valid", "absent", "nonstring", "too_long"]
    },
    {
      "name": "token_auth_method",
      "values": ["absent", "none", "client_secret_basic", "nonstring", "unsupported"]
    },
    {
      "name": "application_type",
      "values": ["absent", "recognized", "unknown_string", "nonstring"]
    }
  ],
  "constraints": [
    {
      "type": "forced",
      "_why": "Public-client happy path.",
      "assignments": [
        {"parameter": "redirect_uris", "value": "valid"},
        {"parameter": "client_name", "value": "valid"},
        {"parameter": "token_auth_method", "value": "none"},
        {"parameter": "application_type", "value": "recognized"}
      ]
    },
    {
      "type": "forced",
      "_why": "Confidential-client happy path with optional metadata absent.",
      "assignments": [
        {"parameter": "redirect_uris", "value": "valid"},
        {"parameter": "client_name", "value": "absent"},
        {"parameter": "token_auth_method", "value": "client_secret_basic"},
        {"parameter": "application_type", "value": "absent"}
      ]
    }
  ]
}
