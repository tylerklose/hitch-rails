#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require_relative "../tooling/final_local_gates"

ROOT = File.expand_path("..", __dir__)

def usage!(message = nil)
  warn message if message
  warn "Usage: HITCH_FINAL_LOCAL_GATES_REPORT=/outside/repository/report.json bin/final-local-gates"
  exit 64
end

usage!("Unexpected arguments: #{ARGV.join(' ')}") unless ARGV.empty?
report_path = ENV["HITCH_FINAL_LOCAL_GATES_REPORT"]
usage!("HITCH_FINAL_LOCAL_GATES_REPORT is required") unless report_path && !report_path.empty?

begin
  result = HitchFinalLocalGates.run!(root: ROOT, report_path:)
  puts JSON.pretty_generate(result.slice("path", "sha256"))
rescue HitchFinalLocalGates::VerificationError, ArgumentError => error
  warn error.message
  exit 1
end
