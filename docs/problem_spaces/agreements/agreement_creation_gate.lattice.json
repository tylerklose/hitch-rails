{
  "model_name": "agreement_creation_gate",
  "_intent_notes": [
    "Exploratory pairwise review model for the proposed document-plus-parties agreement kernel.",
    "The host owns document meaning, party authority, acceptance rules, and downstream consequences.",
    "The kernel may create an Agreement only for one exact immutable revision, a complete snapshotted roster, an intended party or authorized representative, an open issuance, valid assent evidence, and satisfied quorum.",
    "A valid assent with pending quorum may be recorded but cannot create an Agreement. A replay must be idempotent and conflicting evidence must not mutate truth.",
    "This is a problem-space artifact, not a Hitch runtime contract or public API commitment."
  ],
  "parameters": [
    {
      "name": "revision_integrity",
      "values": ["exact_immutable", "mutable_or_mismatched"]
    },
    {
      "name": "party_roster",
      "values": ["complete_snapshot", "missing_required_party"]
    },
    {
      "name": "actor_capacity",
      "values": ["intended_person", "authorized_representative", "unauthorized_or_unknown"]
    },
    {
      "name": "assent_method",
      "values": ["hosted_native", "external_provider", "paper_or_in_person"]
    },
    {
      "name": "evidence_posture",
      "values": ["valid_new", "exact_replay", "invalid_or_conflicting"]
    },
    {
      "name": "issuance_posture",
      "values": ["open", "expired_or_revoked", "superseded"]
    },
    {
      "name": "quorum_evaluation",
      "values": ["pending", "satisfied", "invalid_roster"]
    }
  ],
  "constraints": [
    {
      "type": "bidirectional",
      "_why": "A missing required party makes quorum invalid, and invalid roster is reserved for that condition.",
      "pair": [
        {"parameter": "party_roster", "value": "missing_required_party"},
        {"parameter": "quorum_evaluation", "value": "invalid_roster"}
      ]
    },
    {
      "type": "forward_dep",
      "_why": "An exact replay is exact only when it references the same immutable revision as the stored assent.",
      "source": {"parameter": "evidence_posture", "value": "exact_replay"},
      "target": {"parameter": "revision_integrity", "value": "exact_immutable"}
    },
    {
      "type": "forward_dep",
      "_why": "An exact replay can only reference an assent accepted against a complete frozen roster.",
      "source": {"parameter": "evidence_posture", "value": "exact_replay"},
      "target": {"parameter": "party_roster", "value": "complete_snapshot"}
    },
    {
      "type": "invalid_pair",
      "_why": "Unknown or unauthorized identity cannot claim the idempotent result of another actor's stored assent.",
      "if": {"parameter": "evidence_posture", "value": "exact_replay"},
      "then_not": {"parameter": "actor_capacity", "value": "unauthorized_or_unknown"}
    },
    {
      "type": "forced",
      "_why": "Pin agreement creation by an intended person through the native hosted ceremony.",
      "assignments": [
        {"parameter": "revision_integrity", "value": "exact_immutable"},
        {"parameter": "party_roster", "value": "complete_snapshot"},
        {"parameter": "actor_capacity", "value": "intended_person"},
        {"parameter": "assent_method", "value": "hosted_native"},
        {"parameter": "evidence_posture", "value": "valid_new"},
        {"parameter": "issuance_posture", "value": "open"},
        {"parameter": "quorum_evaluation", "value": "satisfied"}
      ]
    },
    {
      "type": "forced",
      "_why": "Pin agreement creation by an authorized representative through an external provider.",
      "assignments": [
        {"parameter": "revision_integrity", "value": "exact_immutable"},
        {"parameter": "party_roster", "value": "complete_snapshot"},
        {"parameter": "actor_capacity", "value": "authorized_representative"},
        {"parameter": "assent_method", "value": "external_provider"},
        {"parameter": "evidence_posture", "value": "valid_new"},
        {"parameter": "issuance_posture", "value": "open"},
        {"parameter": "quorum_evaluation", "value": "satisfied"}
      ]
    },
    {
      "type": "forced",
      "_why": "Pin agreement creation through reviewed paper or in-person evidence.",
      "assignments": [
        {"parameter": "revision_integrity", "value": "exact_immutable"},
        {"parameter": "party_roster", "value": "complete_snapshot"},
        {"parameter": "actor_capacity", "value": "intended_person"},
        {"parameter": "assent_method", "value": "paper_or_in_person"},
        {"parameter": "evidence_posture", "value": "valid_new"},
        {"parameter": "issuance_posture", "value": "open"},
        {"parameter": "quorum_evaluation", "value": "satisfied"}
      ]
    },
    {
      "type": "forced",
      "_why": "Pin valid partial assent through an external provider without premature agreement.",
      "assignments": [
        {"parameter": "revision_integrity", "value": "exact_immutable"},
        {"parameter": "party_roster", "value": "complete_snapshot"},
        {"parameter": "actor_capacity", "value": "authorized_representative"},
        {"parameter": "assent_method", "value": "external_provider"},
        {"parameter": "evidence_posture", "value": "valid_new"},
        {"parameter": "issuance_posture", "value": "open"},
        {"parameter": "quorum_evaluation", "value": "pending"}
      ]
    },
    {
      "type": "forced",
      "_why": "Pin an idempotent replay after quorum so it cannot create a second assent or agreement.",
      "assignments": [
        {"parameter": "revision_integrity", "value": "exact_immutable"},
        {"parameter": "party_roster", "value": "complete_snapshot"},
        {"parameter": "actor_capacity", "value": "intended_person"},
        {"parameter": "assent_method", "value": "external_provider"},
        {"parameter": "evidence_posture", "value": "exact_replay"},
        {"parameter": "issuance_posture", "value": "open"},
        {"parameter": "quorum_evaluation", "value": "satisfied"}
      ]
    }
  ],
  "strength": 2
}
