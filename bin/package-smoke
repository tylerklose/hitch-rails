ROOT = File.expand_path("..", __dir__)
GEMSPEC_PATH = File.join(ROOT, "hitch-rails.gemspec")
SEALED_CHECKPOINT_DECISION_PATH = "docs/evidence/0.2.0/release/pre4-publication-decision.json"
SEALED_CHECKOUT_DRIFT_ALLOWLIST = %w[ROADMAP.md].freeze
PACKAGE_APP_SERVER_VERSION = "8.0.2"
PACKAGE_SMOKE_USAGE = "Usage: bin/package-smoke [--automated-clients]"
unless ARGV.empty? || ARGV == [ "--automated-clients" ]
  warn PACKAGE_SMOKE_USAGE
  exit 64
end

automated_client_environment = ENV["HITCH_AUTOMATED_CLIENT_SMOKES"]
unless automated_client_environment.nil? || automated_client_environment == "1"
  raise "HITCH_AUTOMATED_CLIENT_SMOKES must be 1 when present"
end
AUTOMATED_CLIENT_SMOKES = ARGV == [ "--automated-clients" ] || automated_client_environment == "1"
require_relative "../test/checkpoint/automated_clients" if AUTOMATED_CLIENT_SMOKES

PROFILES = {
  "rails_7_2_sqlite" => {
    appraisal: File.join(ROOT, "gemfiles/rails_7_2_sqlite.gemfile"),
    rails: "~> 7.2.0",
    adapter: "sqlite3",
    adapter_gem: 'gem "sqlite3", ">= 2.1", "< 3"'
  },
  "rails_8_1_postgresql" => {
    appraisal: File.join(ROOT, "gemfiles/rails_8_1_postgresql.gemfile"),
    rails: "~> 8.1.0",
    adapter: "postgresql",
    adapter_gem: 'gem "pg", ">= 1.5", "< 2"'
  }
}.freeze

FORBIDDEN_PACKAGE_PATHS = [
  %r{\A(?:test|spec|tmp|log)/},
  %r{\Adocs/(?:evidence|work_packets)/},
  %r{\A\.git},
  %r{(?:\A|/)\.env(?:\.|\z)},
  %r{(?:\A|/)master\.key\z},
  %r{(?:\A|/)credentials\.ya?ml\.enc\z},
  %r{\.(?:pem|key)\z}
].freeze

