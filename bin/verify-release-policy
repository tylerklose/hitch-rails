#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "optparse"
require "time"
require "yaml"

EXPECTED_ARTIFACTS = {
  "M0.5" => [ "0.1.0", "internal_only" ],
  "M2.3" => [ "0.2.0.pre.1", "internal_only" ],
  "M3.3" => [ "0.2.0.pre.2", "internal_only" ],
  "M4.5" => [ "0.2.0.pre.3", "internal_only" ],
  "M5.4" => [ "0.2.0.pre.4", "public_optional" ],
  "M6" => [ "0.2.0.rc1", "public_if_pre4_published" ],
  "M7" => [ "0.2.0.rc2", "public_if_pre4_published" ],
  "M8" => [ "0.2.0", "public_required" ]
}.freeze
EXPECTED_DEVELOPMENT_VERSIONS = {
  "M5.4" => "0.2.0.pre.4.dev",
  "M6" => "0.2.0.rc1.dev",
  "M7" => "0.2.0.rc2.dev"
}.freeze

EVIDENCE_ROOT = "docs/evidence/0.1.0/checkpoint"
EVIDENCE_PATHS = {
  "ci_matrix" => "#{EVIDENCE_ROOT}/ci-matrix.json",
  "package_manifest" => "#{EVIDENCE_ROOT}/package-manifest.json",
  "disposable_apps" => "#{EVIDENCE_ROOT}/disposable-apps.json",
  "publication_status" => "#{EVIDENCE_ROOT}/publication-status.json"
}.freeze
PRE4_DECISION_PATH = "docs/evidence/0.2.0/release/pre4-publication-decision.json"
DOWNLOADED_PRE4_PATH = "docs/evidence/0.2.0/release/downloaded-pre4.json"
PRE4_VERSION = "0.2.0.pre.4"
PRE4_ARTIFACT = "hitch-rails-0.2.0.pre.4.gem"
PRE4_GITHUB_RELEASE = "https://github.com/tylerklose/hitch-rails/releases/tag/v0.2.0.pre.4"

Options = Data.define(:root, :acceptance)

def parse_options(argv)
  root = File.expand_path("..", __dir__)
  acceptance = false
  parser = OptionParser.new do |options|
    options.banner = "Usage: bin/verify-release-policy [--root PATH] [--acceptance]"
    options.on("--root PATH", "Repository root") { |path| root = File.expand_path(path) }
    options.on("--acceptance", "Require a sealed and fully green M0 checkpoint") { acceptance = true }
  end
  parser.parse!(argv)
  abort "Unexpected arguments: #{argv.join(' ')}" unless argv.empty?
  Options.new(root:, acceptance:)
end

def load_json(root, relative_path, errors)
  path = File.join(root, relative_path)
  unless File.file?(path)
    errors << "missing #{relative_path}"
    return {}
  end

  JSON.parse(File.read(path))
rescue JSON::ParserError => error
  errors << "#{relative_path}: invalid JSON: #{error.message}"
  {}
end

def load_exact_json(root, relative_path, errors)
  path = File.join(root, relative_path)
  unless File.file?(path)
    errors << "missing #{relative_path}"
    return
  end

  JSON.parse(File.read(path), allow_duplicate_key: false)
rescue JSON::ParserError => error
  errors << "#{relative_path}: invalid JSON: #{error.message}"
  nil
end

def forty_hex?(value)
  value.is_a?(String) && value.match?(/\A[0-9a-f]{40}\z/)
end

def sha256?(value)
  value.is_a?(String) && value.match?(/\A[0-9a-f]{64}\z/)
end

def exact_object(value, label, keys, errors)
  unless value.is_a?(Hash)
    errors << "#{label} must be an object"
    return {}
  end

  errors << "#{label} fields must be exactly #{keys.join(', ')}" unless value.keys.sort == keys.sort
  value
end

def iso8601?(value)
  return false unless value.is_a?(String)

  Time.iso8601(value)
  true
rescue ArgumentError
  false
end

def validate_checkpoint(decision, errors)
  checkpoint = exact_object(
    decision["checkpoint"], "pre4 checkpoint", %w[status version source artifact], errors
  )
  errors << "pre4 checkpoint must be accepted_internal_checkpoint" unless
    checkpoint["status"] == "accepted_internal_checkpoint"
  errors << "pre4 checkpoint version must be #{PRE4_VERSION}" unless checkpoint["version"] == PRE4_VERSION

  source = exact_object(checkpoint["source"], "pre4 checkpoint source", %w[commit tree clean_worktree], errors)
  errors << "pre4 checkpoint source commit must be 40-hex" unless forty_hex?(source["commit"])
  errors << "pre4 checkpoint source tree must be 40-hex" unless forty_hex?(source["tree"])
  errors << "pre4 checkpoint source must record a clean worktree" unless source["clean_worktree"] == true

  artifact = exact_object(checkpoint["artifact"], "pre4 checkpoint artifact", %w[name sha256], errors)
  errors << "pre4 checkpoint artifact must be #{PRE4_ARTIFACT}" unless artifact["name"] == PRE4_ARTIFACT
  errors << "pre4 checkpoint artifact needs a SHA-256 pin" unless sha256?(artifact["sha256"])
  artifact
end

def validate_m6_input(decision, artifact, expected_kind, errors)
  input = exact_object(decision["m6_input"], "M6 input", %w[kind artifact sha256], errors)
  errors << "M6 input kind must be #{expected_kind}" unless input["kind"] == expected_kind
  errors << "M6 must consume the exact accepted pre4 artifact" unless
    input["artifact"] == artifact["name"] && input["sha256"] == artifact["sha256"]
end

def validate_product_clients(decision, root, deferred:, errors:)
  clients = exact_object(
    decision["product_clients"], "product clients", %w[approval status evidence_path], errors
  )
  unapproved = clients == {
    "approval" => "not_approved",
    "status" => "not_run",
    "evidence_path" => nil
  }
  if deferred
    errors << "deferred pre4 product clients must be unapproved and not run" unless unapproved
    return
  end
  return if unapproved

  evidence_path = clients["evidence_path"]
  approved = clients["approval"] == "approved" && clients["status"] == "passed" &&
    evidence_path.is_a?(String) && evidence_path.match?(%r{\Adocs/evidence/0\.2\.0/clients/.+\.json\z}) &&
    File.file?(File.join(root, evidence_path))
  errors << "published pre4 product clients must be unapproved/not run or approved/passed with evidence" unless approved
end

def validate_deferred_pre4(decision, artifact, publication, downloaded, root, errors)
  %w[tag_created github_release_created rubygems_publication_performed].each do |field|
    errors << "deferred pre4 publication action #{field} must be false" unless publication[field] == false
  end
  %w[repository_tag github_release rubygems_artifact rubygems_sha256].each do |field|
    errors << "deferred pre4 publication identifier #{field} must be null" unless
      publication.key?(field) && publication[field].nil?
  end
  errors << "deferred pre4 downloaded verification must be not_applicable" unless downloaded == {
    "status" => "not_applicable", "evidence_path" => nil
  }
  errors << "deferred pre4 must not contain #{DOWNLOADED_PRE4_PATH}" if
    File.exist?(File.join(root, DOWNLOADED_PRE4_PATH))

  validate_m6_input(decision, artifact, "accepted_internal_artifact", errors)
  validate_product_clients(decision, root, deferred: true, errors:)
end

def validate_published_pre4(decision, artifact, publication, downloaded, root, errors)
  %w[tag_created github_release_created rubygems_publication_performed].each do |field|
    errors << "published pre4 publication action #{field} must be true" unless publication[field] == true
  end
  errors << "published pre4 repository tag must be v#{PRE4_VERSION}" unless
    publication["repository_tag"] == "v#{PRE4_VERSION}"
  errors << "published pre4 GitHub release identifier must name the exact release" unless
    publication["github_release"] == PRE4_GITHUB_RELEASE
  errors << "published pre4 RubyGems artifact must match the accepted checkpoint" unless
    publication["rubygems_artifact"] == artifact["name"]
  errors << "published pre4 RubyGems SHA-256 must match the accepted checkpoint" unless
    publication["rubygems_sha256"] == artifact["sha256"]
  errors << "published pre4 downloaded verification must name its exact evidence" unless downloaded == {
    "status" => "verified_published_artifact", "evidence_path" => DOWNLOADED_PRE4_PATH
  }

  downloaded_evidence = load_exact_json(root, DOWNLOADED_PRE4_PATH, errors)
  if downloaded_evidence
    errors << "downloaded pre4 evidence release identity drifted" unless
      downloaded_evidence["release"] == PRE4_VERSION &&
        downloaded_evidence["status"] == "verified_published_artifact"
    errors << "downloaded pre4 artifact identity differs from the accepted checkpoint" unless
      downloaded_evidence.dig("rubygems", "artifact") == artifact["name"] &&
        downloaded_evidence.dig("rubygems", "sha256") == artifact["sha256"]
    errors << "downloaded pre4 tag differs from the publication decision" unless
      downloaded_evidence.dig("repository", "tag") == publication["repository_tag"]
  end

  validate_m6_input(decision, artifact, "published_pre4", errors)
  validate_product_clients(decision, root, deferred: false, errors:)
end

def validate_pre4_decision(decision, root, errors)
  decision = exact_object(
    decision,
    "pre4 publication decision",
    %w[schema milestone recorded_at decision checkpoint publication downloaded_pre4 m6_input product_clients],
    errors
  )
  return if decision.empty?

  errors << "pre4 publication decision schema drifted" unless
    decision["schema"] == "hitch.m5.4-pre4-publication-decision.v1"
  errors << "pre4 publication decision milestone must be M5.4" unless decision["milestone"] == "M5.4"
  errors << "pre4 publication decision needs an ISO-8601 recorded_at" unless iso8601?(decision["recorded_at"])

  artifact = validate_checkpoint(decision, errors)
  publication = exact_object(
    decision["publication"],
    "pre4 publication",
    %w[
      tag_created
      github_release_created
      rubygems_publication_performed
      repository_tag
      github_release
      rubygems_artifact
      rubygems_sha256
    ],
    errors
  )
  downloaded = exact_object(
    decision["downloaded_pre4"], "pre4 downloaded verification", %w[status evidence_path], errors
  )

  case decision["decision"]
  when "deferred_to_final"
    validate_deferred_pre4(decision, artifact, publication, downloaded, root, errors)
  when "published_pre4"
    validate_published_pre4(decision, artifact, publication, downloaded, root, errors)
  else
    errors << "pre4 decision must be exactly deferred_to_final or published_pre4"
  end
end

options = parse_options(ARGV)
root = options.root
errors = []

index_path = File.join(root, "docs/work_packets/index.yml")
index = if File.file?(index_path)
  YAML.safe_load_file(index_path, permitted_classes: [], aliases: false)
else
  errors << "missing docs/work_packets/index.yml"
  {}
end

errors << "work-packet schema must be 2" unless index["schema_version"] == 2
first_public = index.dig("distribution_policy", "first_public_eligible")
unless first_public == {
  "issue" => "M5.4",
  "version" => "0.2.0.pre.4",
  "decisions" => %w[published_pre4 deferred_to_final]
}
  errors << "first public eligibility must be M5.4/0.2.0.pre.4 with publish-or-defer decisions"
end
unless index.dig("distribution_policy", "final_public_release") == {
  "issue" => "M8", "version" => "0.2.0"
}
  errors << "final 0.2.0 must be the required public release"
end

EXPECTED_ARTIFACTS.each do |issue, (version, distribution)|
  artifact = index.dig("nodes", issue, "artifact")
  unless artifact.is_a?(Hash) && artifact["version"] == version && artifact["distribution"] == distribution
    errors << "#{issue} must own #{version} as #{distribution}"
  end
end
EXPECTED_DEVELOPMENT_VERSIONS.each do |issue, version|
  unless index.dig("nodes", issue, "artifact", "development_version") == version
    errors << "#{issue} must own mutable development identity #{version}"
  end
end

pre_public = %w[M0.5 M2.3 M3.3 M4.5]
pre_public.each do |issue|
  artifact = index.dig("nodes", issue, "artifact") || {}
  errors << "#{issue} may not name a public verifier" if artifact.key?("public_verifier")
end
errors << "M5.4 must own bin/release-check" unless
  index.dig("nodes", "M5.4", "creates_commands")&.include?("bin/release-check")

workflow_path = File.join(root, ".github/workflows/ci.yml")
workflow = File.file?(workflow_path) ? File.read(workflow_path) : ""
errors << "public CI must not upload or retain an installable .gem before M5" if
  workflow.match?(/\.gem(?:\s|["']|\z)/)

publication = load_json(root, EVIDENCE_PATHS.fetch("publication_status"), errors)
errors << "M0 publication status must be intentionally_not_published" unless
  publication["status"] == "intentionally_not_published"
errors << "M0 publication must be false" unless publication["published"] == false
%w[rubygems_artifact rubygems_sha256 repository_tag github_release].each do |field|
  errors << "M0 publication field #{field} must be null" unless publication.key?(field) && publication[field].nil?
end
unless publication.dig("next_public_eligible", "issue") == "M5.4" &&
    publication.dig("next_public_eligible", "version") == "0.2.0.pre.4"
  errors << "M0 publication evidence must point to M5.4/0.2.0.pre.4"
end

official = load_json(root, "docs/evidence/0.1.0/auth/official-metadata.json", errors)
extension = load_json(root, "docs/evidence/0.1.0/auth/resource-aware-grants.json", errors)
errors << "official metadata classification drifted" unless
  official["classification"] == "official_unmodified_authorization_metadata"
errors << "resource-aware extension classification drifted" unless
  extension["classification"] == "reviewed_resource_indicator_extension"
[ [ "official metadata", official ], [ "resource-aware extension", extension ] ].each do |label, evidence|
  errors << "#{label} evidence contains credentials" unless evidence["contains_credentials"] == false
  errors << "#{label} raw output must be destroyed and never uploaded" unless
    evidence["raw_artifact"].to_s.include?("destroyed") && evidence["raw_artifact"].to_s.include?("never uploaded")
end

completion = load_json(root, "#{EVIDENCE_ROOT}/completion.json", errors)
errors << "completion must identify M0/0.1.0" unless
  completion["milestone"] == "M0" && completion["version"] == "0.1.0"
errors << "completion must record published false" unless completion["published"] == false
errors << "completion evidence references drifted" unless completion["evidence"] == EVIDENCE_PATHS

pre4_decision = load_exact_json(root, PRE4_DECISION_PATH, errors)
validate_pre4_decision(pre4_decision, root, errors) if pre4_decision

if options.acceptance
  errors << "M0 checkpoint is not accepted" unless
    completion["accepted"] == true && completion["status"] == "accepted_internal_checkpoint"
  source = completion["source"] || {}
  errors << "accepted checkpoint needs a 40-hex source commit" unless forty_hex?(source["commit"])
  errors << "accepted checkpoint needs a 40-hex source tree" unless forty_hex?(source["tree"])
  errors << "accepted checkpoint must record a clean worktree" unless source["clean_worktree"] == true

  matrix = load_json(root, EVIDENCE_PATHS.fetch("ci_matrix"), errors)
  lanes = matrix["required_lanes"]
  unless lanes.is_a?(Array) && lanes.length == 2 && lanes.all? { |lane| lane.dig("exact_result", "result") == "green" }
    errors << "both exact checkpoint lanes must be green"
  end

  package = load_json(root, EVIDENCE_PATHS.fetch("package_manifest"), errors)
  errors << "package manifest is not an accepted internal checkpoint" unless
    package["status"] == "internal_checkpoint_verified"
  errors << "package source identity differs from completion" unless package["source_identity"] == source
  errors << "completion gates are not all green" unless
    completion["gates"].is_a?(Hash) && completion["gates"].values.all? { |value| value == "green" }
end

if errors.any?
  warn errors.uniq.join("\n")
  exit 1
end

state = completion["accepted"] ? "accepted" : "candidate; acceptance still pending"
puts "Verified release policy, M0 #{state}, and M5.4 #{pre4_decision.fetch('decision')}."
