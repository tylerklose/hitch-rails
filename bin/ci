#!/usr/bin/env ruby
# frozen_string_literal: true

require "yaml"

ROOT = File.expand_path("..", __dir__)
RELEASE_PROFILES = YAML.safe_load_file(
  File.join(ROOT, "docs/contracts/release_matrix.yml"),
  permitted_classes: [],
  aliases: false
).fetch("lanes").map { |lane| lane.fetch("name") }.freeze

# bin/ci-rate-limit is the only gate that resolves the rate-limit fallback —
# and the production boot depending on it — against a real Redis rather than a
# synthetic store that merely satisfies the predicate. It is also the only gate
# here that needs Docker, so the answer is settled before anything long runs.
REDIS_LANE = system("docker", "info", out: File::NULL, err: File::NULL)
unless REDIS_LANE || ENV["HITCH_SKIP_REDIS_LANE"] == "1"
  abort <<~MESSAGE
    Docker is unavailable, so bin/ci-rate-limit cannot run.
    Start Docker, or pass HITCH_SKIP_REDIS_LANE=1 to run the rest without
    proving the rate-limit fallback against a real Redis.
  MESSAGE
end

def run!(*command, environment: {})
  puts
  puts "+ #{command.join(' ')}"
  return if system(environment, *command, chdir: ROOT)

  abort "CI command failed: #{command.join(' ')}"
end

run!(File.join(ROOT, "bin/rubocop"))

RELEASE_PROFILES.each do |profile|
  run!(
    File.join(ROOT, "bin/ci-appraisal"), profile, "--",
    File.join(ROOT, "bin/rails"), "test",
    environment: { "HITCH_FAIL_ON_SKIPS" => "1" }
  )
end

RELEASE_PROFILES.each do |profile|
  run!(
    File.join(ROOT, "bin/ci-appraisal"), profile, "--",
    "bundle", "exec", "rake", "app:zeitwerk:check"
  )
end

run!(File.join(ROOT, "bin/ci-migrations"))

run!(File.join(ROOT, "bin/ci-rate-limit")) if REDIS_LANE

run!(File.join(ROOT, "bin/conformance-server"))
run!(File.join(ROOT, "bin/package-smoke"))

puts
if REDIS_LANE
  puts "All Hitch CI gates passed."
else
  puts "Hitch CI gates passed, EXCEPT bin/ci-rate-limit: the rate-limit " \
       "fallback and the production boot never met a real Redis."
end
