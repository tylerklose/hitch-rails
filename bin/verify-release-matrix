#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler"
require "optparse"
require "rubygems"
require "yaml"

CONTRACT_PATH = "docs/contracts/release_matrix.yml"
WORKFLOW_PATH = ".github/workflows/ci.yml"
SQLITE_BUSY_TIMEOUT_MS = 5_000
EXPECTED_LANES = [
  {
    "name" => "rails_7_2_mcp_min_sqlite",
    "ruby" => "3.3",
    "rails" => "~> 7.2.0",
    "mcp" => "= 1.1.0",
    "mcp_lane" => "min",
    "adapter" => "sqlite3",
    "adapter_requirement" => ">= 2.1, < 3",
    "gemfile" => "gemfiles/rails_7_2_mcp_min_sqlite.gemfile"
  },
  {
    "name" => "rails_7_2_mcp_latest_postgresql",
    "ruby" => "3.3",
    "rails" => "~> 7.2.0",
    "mcp" => ">= 1.1, < 2",
    "mcp_lane" => "latest",
    "adapter" => "postgresql",
    "adapter_requirement" => ">= 1.5, < 2",
    "gemfile" => "gemfiles/rails_7_2_mcp_latest_postgresql.gemfile"
  },
  {
    "name" => "rails_8_0_mcp_min_postgresql",
    "ruby" => "3.4",
    "rails" => "~> 8.0.0",
    "mcp" => "= 1.1.0",
    "mcp_lane" => "min",
    "adapter" => "postgresql",
    "adapter_requirement" => ">= 1.5, < 2",
    "gemfile" => "gemfiles/rails_8_0_mcp_min_postgresql.gemfile"
  },
  {
    "name" => "rails_8_1_mcp_latest_sqlite",
    "ruby" => "4.0",
    "rails" => "~> 8.1.0",
    "mcp" => ">= 1.1, < 2",
    "mcp_lane" => "latest",
    "adapter" => "sqlite3",
    "adapter_requirement" => ">= 2.1, < 3",
    "gemfile" => "gemfiles/rails_8_1_mcp_latest_sqlite.gemfile"
  }
].freeze

def load_yaml(path, label, errors)
  YAML.safe_load_file(path, permitted_classes: [], aliases: false)
rescue Errno::ENOENT, Psych::Exception => error
  errors << "#{label}: #{error.message}"
  {}
end

def gem_declaration(source, name)
  source.each_line.filter_map do |line|
    match = line.match(/^gem "#{Regexp.escape(name)}"(?<requirements>(?:, "[^"]+")*)/)
    next unless match

    match[:requirements].scan(/"([^"]+)"/).flatten.join(", ")
  end
end

def requirement(source)
  Gem::Requirement.new(*source.split(", "))
end

def expected_workflow_rows
  EXPECTED_LANES.map do |lane|
    profile = lane.fetch("name")
    adapter = lane.fetch("adapter")
    database_url = if adapter == "sqlite3"
      "sqlite3:/tmp/#{profile}.sqlite3?timeout=#{SQLITE_BUSY_TIMEOUT_MS}"
    else
      "postgresql://postgres:postgres@127.0.0.1:5432/#{profile}_test"
    end
    {
      "ruby" => lane.fetch("ruby"),
      "rails" => lane.fetch("rails")[/\d+\.\d+/],
      "adapter" => adapter,
      "profile" => profile,
      "gemfile" => lane.fetch("gemfile"),
      "database_url" => database_url
    }
  end
end

root = File.expand_path("..", __dir__)
OptionParser.new do |options|
  options.on("--root PATH") { |path| root = File.expand_path(path) }
end.parse!(ARGV)
abort "Unexpected arguments: #{ARGV.join(' ')}" unless ARGV.empty?

errors = []
contract = load_yaml(File.join(root, CONTRACT_PATH), "release matrix contract", errors)
unless contract == {
  "schema_version" => 1,
  "release" => "0.2.0",
  "sqlite_busy_timeout_ms" => SQLITE_BUSY_TIMEOUT_MS,
  "lanes" => EXPECTED_LANES
}
  errors << "release matrix contract must be the exact four-lane 0.2 matrix"
end

version_source = File.read(File.join(root, "lib/hitch/version.rb"))
hitch_version = version_source[/VERSION\s*=\s*["']([^"']+)["']/, 1]
errors << "could not resolve Hitch::VERSION" unless hitch_version

EXPECTED_LANES.each do |lane|
  gemfile = File.join(root, lane.fetch("gemfile"))
  lockfile = "#{gemfile}.lock"
  unless File.file?(gemfile)
    errors << "#{lane.fetch('name')}: missing #{lane.fetch('gemfile')}"
    next
  end
  unless File.file?(lockfile)
    errors << "#{lane.fetch('name')}: missing #{lane.fetch('gemfile')}.lock"
    next
  end

  source = File.read(gemfile)
  adapter_gem = lane.fetch("adapter") == "sqlite3" ? "sqlite3" : "pg"
  declarations = {
    "rails" => gem_declaration(source, "rails"),
    "mcp" => gem_declaration(source, "mcp"),
    adapter_gem => gem_declaration(source, adapter_gem)
  }
  expected = {
    "rails" => [ lane.fetch("rails") ],
    "mcp" => [ lane.fetch("mcp") ],
    adapter_gem => [ lane.fetch("adapter_requirement") ]
  }
  errors << "#{lane.fetch('name')}: gem declarations drifted" unless declarations == expected
  other_adapter = adapter_gem == "sqlite3" ? "pg" : "sqlite3"
  errors << "#{lane.fetch('name')}: gemfile includes both database adapters" if gem_declaration(source, other_adapter).any?

  begin
    lock = Bundler::LockfileParser.new(Bundler.read_file(lockfile))
    specs = lock.specs.to_h { |spec| [ spec.name, spec.version ] }
    errors << "#{lane.fetch('name')}: locked Hitch version differs from #{hitch_version}" unless
      specs["hitch-rails"]&.to_s == hitch_version
    errors << "#{lane.fetch('name')}: locked Rails violates #{lane.fetch('rails')}" unless
      specs["rails"] && requirement(lane.fetch("rails")).satisfied_by?(specs.fetch("rails"))
    errors << "#{lane.fetch('name')}: locked mcp violates #{lane.fetch('mcp')}" unless
      specs["mcp"] && requirement(lane.fetch("mcp")).satisfied_by?(specs.fetch("mcp"))
    errors << "#{lane.fetch('name')}: minimum SDK lane must resolve exactly 1.1.0" if
      lane.fetch("mcp_lane") == "min" && specs["mcp"]&.to_s != "1.1.0"
    errors << "#{lane.fetch('name')}: locked adapter violates #{lane.fetch('adapter_requirement')}" unless
      specs[adapter_gem] && requirement(lane.fetch("adapter_requirement")).satisfied_by?(specs.fetch(adapter_gem))
    errors << "#{lane.fetch('name')}: lockfile contains the other database adapter" if specs.key?(other_adapter)
  rescue Bundler::LockfileError, Bundler::GemfileError => error
    errors << "#{lane.fetch('name')}: invalid lockfile: #{error.message}"
  end
end

workflow = load_yaml(File.join(root, WORKFLOW_PATH), "CI workflow", errors)
rows = workflow.dig("jobs", "supported-matrix", "strategy", "matrix", "include")
unless rows.is_a?(Array)
  errors << "CI workflow must declare the supported-matrix include rows"
  rows = []
end
projected_rows = rows.map do |row|
  row.slice("ruby", "rails", "adapter", "profile", "gemfile", "database_url")
end
errors << "CI workflow must run the exact four release-matrix rows" unless projected_rows == expected_workflow_rows
expected_installs = EXPECTED_LANES.map { |lane| lane.fetch("gemfile") }
checkpoint_steps = workflow.dig("jobs", "checkpoint-gates", "steps") || []
installed = checkpoint_steps.filter_map { |step| step.dig("env", "BUNDLE_GEMFILE") if step.is_a?(Hash) }
errors << "checkpoint job must install every release-matrix Gemfile" unless (expected_installs - installed).empty?
checkpoint_checkout = checkpoint_steps.find { |step| step.is_a?(Hash) && step["uses"] == "actions/checkout@v6" }
errors << "checkpoint job must fetch full history for sealed artifact reconstruction" unless
  checkpoint_checkout&.dig("with", "fetch-depth") == 0
expected_ruby = workflow.dig("jobs", "supported-matrix", "env", "HITCH_EXPECTED_RUBY")
errors << "supported matrix must pass its exact Ruby version to the appraisal gate" unless
  expected_ruby == "${{ matrix.ruby }}"
expected_postgres_base = "postgresql://postgres:postgres@127.0.0.1:5432/postgres"
errors << "supported matrix must use the dedicated disposable PostgreSQL base" unless
  workflow.dig("jobs", "supported-matrix", "env", "HITCH_APPRAISAL_POSTGRES_URL") == expected_postgres_base
supported_steps = workflow.dig("jobs", "supported-matrix", "steps") || []
expected_supported_steps = [
  { "uses" => "actions/checkout@v6" },
  {
    "uses" => "ruby/setup-ruby@v1",
    "with" => { "ruby-version" => "${{ matrix.ruby }}", "bundler-cache" => true }
  },
  { "run" => "bin/ci-appraisal ${{ matrix.profile }} -- bin/rails db:create db:migrate" },
  { "run" => "bin/ci-appraisal ${{ matrix.profile }} -- bundle exec rake app:zeitwerk:check" },
  { "run" => "bin/ci-appraisal ${{ matrix.profile }} -- bin/rails test" }
]
projected_supported_steps = supported_steps.first(expected_supported_steps.length).map do |step|
  step.is_a?(Hash) ? step.slice("uses", "with", "run") : step
end
errors << "supported matrix must execute the exact checkout setup database eager-load and test steps" unless
  projected_supported_steps == expected_supported_steps
checkpoint_needs = workflow.dig("jobs", "checkpoint-gates", "needs")
errors << "checkpoint job must depend on both supported-matrix and sdk-lanes" unless
  checkpoint_needs == %w[supported-matrix sdk-lanes]

if errors.any?
  warn errors.uniq.join("\n")
  exit 1
end

puts "Verified 0.2 release matrix: 4 Rails/SDK/database lanes, exact locks, SQLite wait, exact hosted Ruby rows."
